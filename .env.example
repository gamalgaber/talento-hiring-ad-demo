# Resend (https://resend.com) — used by /api/lead to email new leads to Talento
RESEND_API_KEY=
LEAD_TO_EMAIL=info@talento.expert
# Must be a verified sender on your Resend domain, or use onboarding@resend.dev for testing
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used by /api/lead to reject cross-site form submissions in production
NEXT_PUBLIC_SITE_URL=https://your-domain.com
